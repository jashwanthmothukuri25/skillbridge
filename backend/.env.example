# SkillBridge Backend Environment Configuration Template
# Copy this file to .env or export these variables in your terminal

SERVER_PORT=8080

# MySQL Database Configuration
# Default Homebrew MySQL connects with user 'root' and no password
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/skillbridge_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# JWT Secret (Must be at least 256 bits / 32 characters for HMAC-SHA256)
JWT_SECRET=skillbridge_super_secure_secret_key_minimum_256_bits_2026_placement_track!
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
